# ===========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in the values
# ===========================================

# Application
NODE_ENV=development
APP_NAME="Tapvera Scheduler"
APP_PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=your_mongodb_uri
MONGO_DB_NAME=roster_mechanic_dev

# Authentication
JWT_SECRET=your_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Timezone
APP_TIMEZONE=Australia/Sydney

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
# Comma-separate to allow more than one origin, e.g.
# CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Email Configuration
# Set EMAIL_ENABLED=true to enable email sending
EMAIL_ENABLED=false
EMAIL_FROM=noreply@yourdomain.com.au

# Email Service: smtp, gmail, or ses
EMAIL_SERVICE=smtp

# SMTP Configuration (for EMAIL_SERVICE=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Gmail Configuration (for EMAIL_SERVICE=gmail)
# Use EMAIL_USER and EMAIL_PASSWORD from above
# Note: You need to use an App Password, not your regular Gmail password
# Generate one at: https://myaccount.google.com/apppasswords

# AWS SES Configuration (for EMAIL_SERVICE=ses)
AWS_REGION=ap-southeast-2
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=

# File Upload (AWS S3)
AWS_S3_BUCKET=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# Monitoring
SENTRY_DSN=
ENABLE_APM=false

# Feature Flags
ENABLE_API_DOCS=true
ENABLE_REQUEST_LOGGING=true
ENABLE_COMPRESSION=true

# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps (address autocomplete, geocoding, reverse geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================================
# AGENT — GROQ
# ===========================================
# A single GROQ_API_KEY enables all three agent services:
#   STT  →  whisper-large-v3-turbo
#   Plan →  groq/compound-mini  (tool-calling, fast)
#   TTS  →  canopylabs/orpheus-v1-english
#
# Without a key the assistant still works through the typed form.
# Keys are only ever read server-side and never sent to the browser.
#
# Get a key at console.groq.com → API Keys.
# Run `node src/scripts/checkGroq.js` to verify your key works.
GROQ_API_KEY=

# Override defaults only if you need a different model.
# GROQ_PLANNER_MODEL=groq/compound-mini
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TIMEOUT_MS=20000
# GROQ_MAX_OUTPUT_TOKENS=300
