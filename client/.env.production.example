# ==========================================================================
# Client env — PRODUCTION build
# ==========================================================================
#
# Vite reads .env.production automatically when running `npm run build` with
# NODE_ENV=production (the default for `vite build`). Copy this file to
# `.env.production` on the machine that BUILDS the client (not the deploy
# host — Vite bakes these values into the JS bundle at build time).
#
# Deployment topology:
#   Frontend + backend are single-origin at https://scheduler.tapvera.io,
#   reverse-proxied by nginx via a Cloudflare tunnel. The Node process
#   listens on 127.0.0.1:5002 internally and is not directly exposed.
#
# Symptom if this file is missing or wrong:
#   The deployed page tries to reach http://localhost:5000/api/... and every
#   request fails at the CORS/network layer. The login screen misreports
#   this as "invalid credentials".

# REST + WebSocket base. SocketContext derives the socket URL by stripping
# the trailing /api, so keep the /api suffix here.
VITE_API_URL=https://scheduler.tapvera.io/api

# Google Maps key used by the address autocomplete on the site form.
# Restrict this key to the scheduler.tapvera.io referrer in Google Cloud
# Console before shipping.
VITE_GOOGLE_MAPS_API_KEY=
